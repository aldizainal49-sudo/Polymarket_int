# =============================================================================
# Polymarket Weather/Temperature Bot - example environment configuration
# Copy this file to ".env" and fill in your own values:  cp .env.example .env
# =============================================================================

# --- Polymarket / CLOB credentials --------------------------------------------
# These are ONLY needed for LIVE trading. Leave blank for DRY_RUN.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=

# --- Safety switches ----------------------------------------------------------
# DRY_RUN=true  -> never sends real orders (DEFAULT, keep it true until ready).
# LIVE_TRADING=true AND DRY_RUN=false -> the ONLY combination that trades live.
DRY_RUN=true
LIVE_TRADING=false

# --- Scanning -----------------------------------------------------------------
ENABLED_CATEGORIES=weather,temperature
SCAN_INTERVAL_SECONDS=300

# --- Entry price window (in dollars, 0.0 - 1.0) -------------------------------
# Only buy when the YES/NO outcome is already priced as a near-certainty.
MIN_ENTRY_PRICE=0.95
MAX_ENTRY_PRICE=0.985

# --- Resolution timing --------------------------------------------------------
MAX_HOURS_TO_RESOLUTION=12
PREFERRED_HOURS_TO_RESOLUTION=6

# --- Confidence gates ---------------------------------------------------------
MIN_BOT_PROBABILITY=0.95
MIN_CONFIDENCE_SCORE=0.95

# --- Forecast distance from threshold (the safety margin) ---------------------
MIN_TEMP_DISTANCE_C=3.0
MIN_TEMP_DISTANCE_F=5.0

# --- Market microstructure ----------------------------------------------------
MIN_LIQUIDITY_USD=500
MAX_SPREAD_PERCENT=1.0

# --- Risk limits --------------------------------------------------------------
MAX_POSITION_PER_MARKET_USD=1
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_USD=3

# --- Feature flags (keep conservative) ----------------------------------------
ALLOW_LONGSHOT=false
ALLOW_EXACT_TEMP_MARKETS=false
ALLOW_AMBIGUOUS_MARKETS=false

# --- Weather provider ---------------------------------------------------------
# open_meteo (default, no key needed) | weatherapi | meteostat | visual_crossing
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=
